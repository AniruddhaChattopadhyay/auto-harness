# ─── Provider API keys ──────────────────────────────────────────────────────
OPENAI_API_KEY=               # used by the inner agent during benchmark runs (e.g. gpt-5.4)
ANTHROPIC_API_KEY=            # used by the outer agent (Claude Agent SDK)
E2B_API_KEY=                  # sandbox provider for trial execution

# ─── Defaults applied at experiment-create time when not specified by API ───
BENCHMARK_MODEL=gpt-5.4              # inner agent model (passed into sandbox as AGENT_MODEL env var)
OPTIMIZER_MODEL=claude-sonnet-4-6    # outer agent model
OPTIMIZER_KIND=claude_agent_sdk      # which OuterAgent impl to instantiate

# ─── Postgres ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://harness:harness@localhost:5432/harness

# ─── MinIO (S3-compatible) ──────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=harness
MINIO_USE_SSL=false

# ─── Worker tuning ──────────────────────────────────────────────────────────
WORKER_BENCHMARK_CONCURRENCY=2     # how many benchmark.run tasks one worker process handles concurrently
WORKER_OPTIMIZER_CONCURRENCY=2     # how many optimizer.propose tasks one worker process handles concurrently
WORKER_POLL_INTERVAL_SECONDS=2     # how often to check the queue
WORKER_TASK_TIMEOUT_SECONDS=1800   # stale-running sweeper threshold

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
